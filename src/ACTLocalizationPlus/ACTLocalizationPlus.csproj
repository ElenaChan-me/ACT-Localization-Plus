<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ACT は .NET Framework 4.8 で動くので、プラグインも合わせる -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ACTLocalizationPlus</RootNamespace>
    <AssemblyName>ACTLocalizationPlus</AssemblyName>
    <Version>1.0.0</Version>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <!-- 参照する ACT 本体の場所。ビルド時に -p:ActPath=... で変えられる -->
    <ActPath Condition="'$(ActPath)' == ''">$(MSBuildThisFileDirectory)..\..\lib\Advanced Combat Tracker.exe</ActPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ActPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 言語ごとの訳（<言語>.<画面>.xml）を DLL に埋め込む -->
    <EmbeddedResource Include="Localization\*.xml" LogicalName="ACTLocalizationPlus.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
